          "response": []
        },
        {
          "name": "Generate Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({\r\n    url: pm.variables.get(\"base_url\") + \"/chats\",\r\n    method: 'GET',\r\n    header: 'Authorization: Bearer ' + pm.collectionVariables.get(\"poster_token\")\r\n}, function (err, res) {\r\n    var chat = res.json().find(c => c.id === pm.collectionVariables.get(\"chat_id\"));\r\n    pm.collectionVariables.set(\"resolution_otp\", chat.resolutionOtp);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{poster_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/chats/{{chat_id}}/request-resolve-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
