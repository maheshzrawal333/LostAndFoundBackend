# ==============================================================================
spring.application.name=LostAndFoundBackend
server.port=8081

# ==============================================================================
# DATABASE CONFIGURATION (CockroachDB Cloud)
# ==============================================================================
spring.datasource.url=jdbc:postgresql://ruddy-leaper-33527.j77.aws-ap-south-1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
spring.datasource.username=LostAndFoundNepal
spring.datasource.password=mUs7JGVfL4Bz8tnkGKGlpw
spring.datasource.driver-class-name=org.postgresql.Driver

# HikariCP Connection Pool Settings
spring.datasource.hikari.pool-name=SpringBootHikariCP
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.idle-timeout=30000
spring.datasource.hikari.max-lifetime=600000

# ==============================================================================
# JPA & HIBERNATE SETTINGS
# ==============================================================================
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.jdbc.lob.non_contextual_creation=true
# Hibernate 7+ automatically detects PostgreSQL/CockroachDB dialect at runtime

